# =================================----------------===
# [0] 오디오 채널 및 시스템 설정
# =================================----------------===
init python:
    # 빗소리 등 배경 환경음 전용 채널
    renpy.music.register_channel("ambient", mixer="sfx", loop=True)

# 사운드 기능 활성화 및 기본 볼륨 설정
define config.has_sound = True
default preferences.sfx_volume = 1.0

# BGM 파일 변수 정의 (game/audio/bgm/ 경로)
define audio.bgm_main = "audio/bgm/bgm.mp3"
define audio.bgm_daily = "audio/bgm/bgm1.mp3"
define audio.bgm_sad = "audio/bgm/bgm2.mp3"
define audio.bgm_wafu = "audio/bgm/bgm3.mp3"

# SFX 파일 변수 정의 (game/audio/sfx/ 경로)
define audio.sfx_door = "audio/sfx/sfx_door.mp3"
define audio.sfx_bell = "audio/sfx/sfx_bell.mp3"
define audio.sfx_hit = "audio/sfx/sfx_hit.mp3"
define audio.sfx_crash = "audio/sfx/sfx_crash.mp3"
define audio.sfx_magic = "audio/sfx/sfx_magic.mp3"

# =================================----------------===
# 캐릭터 정의
# =================================----------------===
define h = Character('서로아', color="#FF4D4D")
define m = Character('연하랑', color="#c8ffc8")
define j = Character('연하진', color="#8c9eff")
define y = Character('여대생(유나)', color="#E0E0E0")
define g = Character('가주', color="#A0A0A0")

# =================================----------------===
# 이미지 에셋 및 트랜스폼 정의
# =================================----------------===

# --- 배경 이미지 ---
image bg_room_day = "images/bg/home.jpg"
image bg_room_sunset = Transform("images/bg/home.jpg", matrixcolor=TintMatrix("#ffccaa") * BrightnessMatrix(-0.15))
image bg_room_night = Transform("images/bg/home.jpg", matrixcolor=TintMatrix("#4c607a") * BrightnessMatrix(-0.35))
image bg_room_rain = Transform("images/bg/home.jpg", matrixcolor=TintMatrix("#3b4a5a") * BrightnessMatrix(-0.45))
image bg_restaurant_night = "images/bg/meat.jpg"

# 편의점 및 인형뽑기 오락실 에셋
image bg_store_day = "images/bg/bg23_01.jpg"
image bg_store_night = Transform("images/bg/bg23_01.jpg", matrixcolor=TintMatrix("#4c607a") * BrightnessMatrix(-0.35))
image bg_store_interview = Transform("images/bg/bg24_01.jpg", matrixcolor=TintMatrix("#4c607a") * BrightnessMatrix(-0.30))
image bg_arcade = "images/bg/bg25_01.jpg"

# --- 기타 배경 에셋 ---
image bg_street_night = Solid("#2c3e50")
image bg_street_rain = Solid("#17202a")
image bg_alley_night = Solid("#0e1319")
image cg_true_ending = Solid("#fff0e6")

# --- 캐릭터 스탠딩 이미지 (zoom=0.35, yalign=1.0) ---
image hajin normal = Transform("images/character/10_suit_normal.png", zoom=0.35, yalign=1.0)
image hajin angry = Transform("images/character/10_suit_angry.png", zoom=0.35, yalign=1.0)
image hajin laugh = Transform("images/character/10_suit_laugh.png", zoom=0.35, yalign=1.0)
image hajin close = Transform("images/character/10_suit_close.png", zoom=0.35, yalign=1.0)
image hajin damage = Transform("images/character/10_suit_damage.png", zoom=0.35, yalign=1.0)

image roa normal = Transform("images/character/roa_normal.png", zoom=0.35, yalign=1.0)
image roa smile = Transform("images/character/roa_smile.png", zoom=0.35, yalign=1.0)
image roa sad = Transform("images/character/roa_sad.png", zoom=0.35, yalign=1.0)
image roa blush = Transform("images/character/roa_blush.png", zoom=0.35, yalign=1.0)
image roa angry = Transform("images/character/roa_angry.png", zoom=0.35, yalign=1.0)

# =================================----------------===
# 메인 스토리 스크립트 (정식 버전)
# =================================----------------===

label start:
    scene black with fade
    play music bgm_main fadein 1.0

    "이 세상에는 인간의 탈을 쓰고 함께 살아가는 요괴와 악마들이 존재한다."
    "현대 사회에서 뿔이나 꼬리, 여우 귀 같은 특징을 드러내고 다닐 수는 없는 노릇."
    "따라서 영물들이나 퇴마사들, 심지어 마계의 악마들까지도 이형의 특징을 마력으로 완벽하게 숨길 수 있는 능력이 있다."
    "진짜 모습은 마력이 극도로 요동치거나, 방심해서 마력 제어가 풀렸을 때만 드러날 뿐이다."
    "…적어도 내가 가문에서 배운 상식은 그랬다."

    scene bg_room_night with fade
    play sound sfx_door

    m "으아하...."
    m "하아... 오늘 하루도 진짜 영혼까지 털렸네."
    m "퇴마사 가문에서 제발로 나왔을 땐 세상 귀신 다 잡고 부자 될 줄 알았지."
    m "현실은 통장 잔고 1,400원에 컵라면도 감지덕지라니..."

    "터덜터덜 현관문을 열고 자취방으로 들어섰다."
    "그런데..."

    m "...어?"

    "방 한구석, 내가 가장 아끼는 푹신한 소파 위에 누군가 누워있다."
    
    show roa normal at center with dissolve
    "길고 새까만 흑발, 그런데 머리카락 끝부분만 살짝 붉게 물들어 있다... 머리 위에 달린 건 뿔? 그리고 뒤에 보이는 건..."

    play sound sfx_hit
    m "악마... 악마 꼬리?!"
    m "아니, 인간계에 올라왔으면 뿔이랑 꼬리 정도는 숨기고 있는 게 기본 상식 아닙니까?!"

    show roa smile
    h "음냐... 하랑아, 왔어? 오늘 퇴마 일거리는 좀 들어왔니?"

    m "누, 누구세요?! 내 방엔 어떻게 들어온 거며, 내 이름은 또 어떻게 아는 건데?!"

    show roa sad
    h "아하하, 박대하지 마~ 나 정기 부족해서 뿔이랑 꼬리를 숨길 마력도 없단 말이야."
    h "이대로 쫓아내면 나 진짜 길거리에서 바싹 말라 죽어!"

    m "아니, 저는 쫓겨난 '여우 퇴마사'거든요? 악마를 보면 잡아서 협회에 넘겨야 하는 직업이라고요!"

    show roa normal
    h "흐응... 과연 잔고 1,400원짜리 퇴마사 도련님이 나를 잡을 수 있을까?"
    
    show roa smile
    h "대신 나를 얹혀살게 해주면... 청소도 해주고, 맛있는 것도 해줄 테니까! 정기 아주 조금씩만 나눠주면 안 돼?"

    m "하..."
    m "(어이가 없어서 말도 안 나온다. 하지만 저 얼굴로 싹싹 비는 걸 보니 딱히 사람을 해칠 것 같지도 않은데...)"
    m "좋습니다. 단, 몇 가지 규칙이 있습니다."

    show roa smile
    h "정말?! 역시 우리 하랑이 최고!"

    m "첫째, 제 허락 없이 정기를 빼앗지 말 것. 둘째, 집안일은 반반. 셋째..."

    h "셋째는 뭔데?"

    m "제 소파에서 당장 내려오세요. 거긴 제 자리입니다."

    show roa angry
    h "치... 째째하게 굴긴!"

    show roa sad
    "서로아는 하랑의 따끔한 일침에 결국 풀이 죽어 소파에서 내려왔다."

    "얼마 후, 다시 돌아온 자취방."
    "작은 접이식 식탁 위에는 김이 모락모락 피어오르는 컵라면 두 개가 놓여 있다."
    "600원짜리 가장 싼 라면. 내 처지를 대변하는 듯한 그 초라한 음식 앞에서..."

    "스윽-"
    "로아는 아무 말 없이 라면 용기를 양손으로 조심스레 감싸 쥐었다."

    show roa smile
    h "...따뜻해."

    m "그렇게 쥐고 있으면 델 텐데요. 얼른 먹기나 하죠."

    "퉁명스럽게 뱉었지만, 손끝에 전해지는 온기에 옅은 미소를 짓는 그녀의 얼굴을 보니 차마 더 모진 말을 할 수 없었다."

    h "하랑아."
    m "...왜요. 반찬은 없습니다."
    h "고마워."

    "로아가 고개를 들어 나를 보며 작게 속삭였다."

    show roa sad
    h "가장 춥고 외로울 때, 나를 쫓아내지 않아 줘서."
    h "이 라면... 내가 마계에서 먹었던 그 어떤 진수성찬보다 따뜻한 것 같아."

    "가볍게만 보였던 그녀의 미소 뒤에, 왠지 모를 짙은 외로움이 묻어나오는 것 같았다."
    "마치, 가문에서 쫓겨나 홀로 이 좁은 방에 처음 들어왔을 때... 지독하게 추웠던 내 모습처럼."

    m "...다 불어 터집니다. 쓸데없는 소리 말고 먹기나 하세요."

    "나는 멋쩍은 마음에 시선을 피하며 나무젓가락을 쪼갰다."
    "창밖으로는 스산한 밤바람 소리가 들려오고 있었지만,"
    "어쩐지 오늘따라 이 좁고 낡은 방 안이... 아주 조금, 덜 춥게 느껴졌다."

    "다 먹은 라면 용기를 정리하고 돌아서자, 치명적인 문제가 하나 떠올랐다."
    "이 좁은 자취방엔 침대도 없고, 푹신한 잠자리는 오직 내가 아끼는 소파 하나뿐이라는 것."

    m "자, 다 먹었으면 이제 잠자리를 정하죠."
    m "아까 규칙 3번 기억하시죠? 소파는 제겁니다."

    show roa angry
    h "에에?! 아무리 그래도 여자를 맨바닥에서 재우겠다고?!"
    h "나 이래 봬도 섬세한 악마거든? 바닥에서 자면 뿔이랑 꼬리 배겨서 아프단 말이야!"

    m "저는 쫓겨난 퇴마사라 바닥에서 자는 게 익숙할 것 같습니까?"
    m "무단 침입한 불청객한테 제 유일한 안식처를 양보할 생각은 전혀 없습니다."

    h "우으... 치사해, 찌질해, 1,400원짜리 자린고비!"

    show roa sad
    "로아는 볼을 빵빵하게 부풀리며 바닥에 털썩 주저앉았다."
    "그리고는 투덜거리면서도 서럽다는 듯 붉은 꼬리를 푹 늘어뜨렸다."

    m "하..."
    m "(저러고 있으니까 진짜 길거리에 버려진 고양이 같네...)"

    "나는 한숨을 내쉬며 장롱 깊숙이 넣어둔 내 하나뿐인 푹신한 솜이불과 베개를 꺼냈다."
    "그리고 그걸 로아 쪽으로 툭 던졌다."

    show roa normal
    h "앗, 이게 뭐야?"
    m "이불이라도 덮고 자세요. 바닥 차가우니까."
    h "어...? 그럼 하랑이는 뭐 덮고 자게?"
    m "저는 얇은 덮개 이불 하나면 충분합니다. 춥다고 징징대지 말고 얼른 누우세요."

    show roa smile
    "로아는 얼떨떨한 표정으로 솜이불을 안아 들더니, 이내 푹신한 감촉에 얼굴을 묻으며 배시시 웃었다."

    h "헤헤... 뭐야, 하랑이 의외로 다정하잖아?"
    m "꿈깨세요. 내일 아침 일찍 일어날 거니까 시끄럽게 하지 말고 자요."

    "딸깍-"
    hide roa with dissolve
    
    "스위치를 누르자 방 안의 불이 꺼지고, 기분 좋은 어둠이 자리를 채웠다."
    "소파에 누워 천장을 바라보았다."

    "늘 혼자 맞이하던 깜깜하고 차가운 밤."
    "바닥에서 사스락거리는 이불 소리와 누군가의 작은 숨소리가 더해졌을 뿐인데..."
    "이상하게도 오늘따라 방 안의 어둠이 조금 포근하게 느껴졌다."

    h "...하랑아."
    "어둠 속에서 로아의 조용한 목소리가 들려왔다."

    m "왜 또요. 안 자고."
    h "잘 자."
    m "……."
    m "...그쪽도 잘 자요."

    "그렇게, 결코 어울릴 수 없을 것 같았던 퇴마사와 악마의 이상한 첫날밤이 저물어갔다."

    jump chapter_2_job_search

label chapter_2_job_search:
    scene bg_room_day with fade
    play music bgm_daily fadein 1.0

    "쨉쨉, 쨉쨉."
    "창문 틈으로 들어오는 아침 햇살과 함께, 이상한 소리가 들려와 눈을 떴다."

    m "음..."
    "눈을 비비며 몸을 일으키려 했지만, 가슴 부근이 묵직해서 움직일 수가 없었다."
    "천천히 고개를 내려 아래를 바라보았다."

    show roa normal at center with dissolve
    h "음냐... 하랑아, 5분만 더..."

    "내가 어제 양보해 준 솜이불을 말아서 껴안은 채, 내 소파 밑 바닥에 껌딱지처럼 붙어 자고 있는, 끝이 붉게 물든 흑발 장발의 악마."
    "심지어 녀석의 푹신한 악마 꼬리가 내 얼굴 바로 옆에 털썩 올려져 있었다."

    m "……."
    "꿈이... 아니었구나."

    "나는 한숨을 내쉬며 녀석의 뿔을 아주 살짝 건드렸다."

    m "이봐요, 일어나세요. 해 떴습니다."
    
    show roa blush
    h "으응... 뿔 건드리지 마... 간지러워..."

    "로아가 눈을 비비며 번쩍 눈을 떴다. 뻗친 머리와 까치집이 된 모습이 꽤나 가관이다."

    show roa smile
    h "아하암~! 잘 잤다! 인간계 이불은 진짜 따뜻하네!"
    m "제 이불이니까 당연하죠. 그나저나... 제 얼굴에 꼬리 치우시죠."
    
    show roa blush
    h "앗, 미안 미안! 헤헤."

    show roa smile
    "로아는 꼬리를 싹 거두고는 배시시 웃었다."
    "그 해맑은 얼굴을 가만히 바라보다가, 문득 이상한 기분이 들었다."

    m "(...이상하네.)"

    "평소의 나였다면 타인이 내 개인적인 공간에 이렇게 들어왔을 때,"
    "숨이 막히고, 심장이 쿵쾅거리고, 어떻게든 쫓아내고 싶어 안달이 났을 테다."
    "사람이란 존재는 늘 나에게 상처를 주었고, 가식적이었으며, 내게 '완벽한 퇴마사 가문의 후계자'가 될 것만을 강요했으니까."

    "하지만..."
    "제 뿔이 간지럽다며 칭얼대고, 삼각김밥 하나에 감격하는 이 악마 녀석 앞에서는..."
    "이상할 정도로 마음이 조용했다."
    "사람이 아니라는 사실 하나만으로도, 이렇게 숨을 쉬기가 편해질 수 있는 걸까."

    h "하랑아? 왜 그렇게 멍하니 봐? 나 아침부터 너무 예쁜가?"
    m "...헛소리 말고 이불이나 정리하세요. 통장 잔고 1,400원입니다. 오늘 당장 뭐라도 안 하면 저녁은 굶어야 해요."
    
    show roa angry
    h "에에?! 굶는 건 안 돼! 나 오늘 저녁엔 진짜 고기 먹고 싶단 말이야!"
    
    show roa normal
    h "저기... 하랑이는 이제 퇴마 일 안해?"

    m "퇴마 일거리요? 싫습니다. 전 이제 퇴마사 안 합니다."
    h "에에에엣?! 하지만 넌 퇴마사잖아! 부적도 쓸 줄 알고 귀신도 볼 줄 알면서!"
    m "가문에서 나올 때 다 맹세했습니다. 그 이름 팔아서 돈 벌지 않겠다고요."
    m "그 지긋지긋한 가문 그늘에서 벗어나서... 그냥 평범하게 살 겁니다."

    "나는 낡은 겉옷을 걸쳐 입으며 한숨을 내쉬었다."

    m "동네에 단기 알바 구하는 곳이 있는지 찾아볼 테니까, 편하게 꼬리 빼고 집 잘 보고 계세요."
    
    show roa smile
    h "나도 갈래!"
    m "네? 왜요?"
    h "너 혼자 보내면 사람 무섭다고 구석에서 덜덜 떨다가 울면서 돌아올 것 같단 말이야!"
    m "우, 울긴 누가 운다고 그래요?!"

